# fit ----

#' Title
#'
#' @param x 
#' @param y 
#' @param sigma 
#' @param l 
#' @param lambda_krls 
#' @param inv_method 
#' @param compute_Sigma 
#'
#' @return
#' @export
#'
#' @examples
#' 
#' set.seed(123)
#' 
#' n <- 10 ; p <- 2
#' X <- matrix(rnorm(n * p), n, p) # no intercept!
#' y <- rnorm(n)
#' w <- rnorm(n)
#' 
#'  fit_obj <- teabox::gp_fit_matern52(x = X, y = y, 
#'   sigma = 0.01, l= 0.3, compute_Sigma = TRUE)
#'  
#'  preds <- teabox::gp_predict_matern52(fit_obj, newx = X)
#'  
#'  plot(1:nrow(X), y, col = "blue", type = 'l', lwd = 2)
#'  lines(1:nrow(X), preds$mean, col = 'red', lwd = 2)
#'  lines(preds$mean - preds$sd, col = 'red', lty = 2)
#'  lines(preds$mean + preds$sd, col = 'red', lty = 2)
#' 
gp_fit_matern52 <- function(x, y, sigma = 2, 
                            l = 0.1, lambda_krls = 0.1,
                            inv_method = c("chol", "ginv"),
                            compute_Sigma = FALSE)
{
  if (!is.vector(y))
    stop("'y' must be a vector") # otherwise y - ym is not working
  
  x <- as.matrix(x)
  y <- as.vector(y)
  n <- nrow(x)
  p <- ncol(x)
  sigma_ <- rep(sigma, 2)
  
  inv_method <- match.arg(inv_method)
  
  ym <- mean(y)
  centered_y <- y - ym
  
  x_scaled <- teabox::dt_my_scale(x)
  X <- x_scaled$res
  xm <- x_scaled$xm
  xsd <- x_scaled$xsd
  
  # compute kernel
  K <- teabox::cpp_matern52_kxx(x = X, l = l, 
                                theta = rep(sigma, p)) 
  
  coefs <- drop(switch(
    inv_method,
    "chol" = chol2inv(chol(K + lambda_krls * diag(nrow(K)))) %*% centered_y,
    "ginv" = my_ginv(K + lambda_krls * diag(nrow(K))) %*% centered_y
  ))
  names(coefs) <- paste0("c", 1:length(coefs))
  
  lsfit <- drop(crossprod(K, coefs))
  fitted_values <- lsfit  + rep(ym, length(lsfit))
  resid <- y - fitted_values 
  
  return(
    list(
      y = y,
      sigma = sigma,
      l = l,
      K = K,
      lambda_krls = lambda_krls,
      inv_method = inv_method,
      coefs = coefs,
      fitted_values = fitted_values,
      ym = ym,
      xm = xm,
      xsd = xsd,
      scaled_x = X,
      resid = resid,
      compute_Sigma = compute_Sigma
    )
  )
}

gp_bootstrap_fit_matern52 <- function(x, y, B = 10, sigma = 2, 
                                      l = 0.1, lambda_krls = 0.1,
                                      inv_method = c("chol", "ginv"),
                                      compute_Sigma = FALSE)
{
  inv_method <- match.arg(inv_method)
  n <- nrow(x)
  p <- ncol(x)
  
  `%op%` <- foreach::`%do%`
  
  fit_obj <- gp_fit_matern52(x, y, sigma = sigma, 
                             l = l, lambda_krls = lambda_krls,
                             inv_method = inv_method,
                             compute_Sigma = FALSE)
  
  res <- foreach::foreach(i = 1:B, .errorhandling = "remove")%op%{
    teabox::gp_fit_matern52(x = x, y = y + sample(fit_obj$resid, 
                                                  size = n, replace = TRUE), 
                            sigma = sigma, 
                            l = l, lambda_krls = lambda_krls,
                            inv_method = inv_method,
                            compute_Sigma = FALSE)
  }
  
  res
}


# likelihood minimization
gp_max_loglik <- function(x, y,
                          method = c("matern52"), ...)
{
  n <- nrow(x)
  stopifnot(n == length(y))
  method <- match.arg(method)
  
  if (method == "matern52")
  {
    OF <- function(xx)
    {
      Sigma <- cpp_matern52_kxx(x = as.matrix(x),
                                theta = rep(xx[1], ncol(x)),
                                l = xx[2]) + xx[3]*diag(n)
      res <- try(0.5*(n*log(2*pi) + log(det(Sigma)) +
                        drop(crossprod(y, chol2inv(chol(Sigma)) )%*%y)),
                 silent = TRUE)
      
      ifelse(class(res) == "try-error", -1e06, res)
    }
    
    res <- try(teabox::opt_msnlminb(objective = OF, nb_iter = 100,
                                    lower =  c(1e-04, 1e-04, 1e-04),
                                    upper = c(1e05, 1e05, 1e04), ...), 
               silent = FALSE)
    
    if (class(res) != "try-error")
    { 
      names(res$par) <- c("sigma", "l", "lambda")
      return(res) 
    } else {
      print("Error in the optimization loop")
    }
  }
}

# predict ----

gp_predict_matern52 <- function(fit_obj, newx, ci = NULL)
{
  if (is.vector(newx))
    newx <- t(newx)
  
  y <- fit_obj$y
  xm <- fit_obj$xm
  ym <- fit_obj$ym
  xsd <- fit_obj$xsd
  X <- fit_obj$scaled_x
  sigma <- fit_obj$sigma
  sigma_ <- rep(sigma, 2)
  l <- fit_obj$l
  lambda_krls <- fit_obj$lambda_krls
  K <- fit_obj$K
  coefs <- fit_obj$coefs
  compute_Sigma <- fit_obj$compute_Sigma
  scaled_newx <- dt_my_scale(newx, xm = xm, xsd = xsd)
  inv_method <- fit_obj$inv_method
  n_newx <- nrow(newx)
  
  if (is.vector(scaled_newx)) {
    K_star <- teabox::cpp_matern52_kxstar(
      x = X, newx = scaled_newx,
      theta = sigma_, l = l)
  } else {
    K_star <- sapply(1:n_newx, function (i)
      teabox::cpp_matern52_kxstar(
        x = X,
        newx = matrix(scaled_newx[i, ], nrow = 1),
        theta = sigma_,
        l = l
      ))
  }
  
  preds <- drop(crossprod(K_star, coefs)) + ym
  
  if (compute_Sigma == TRUE)
  {
    K_star2 <- teabox::cpp_matern52_kxx(x = scaled_newx,
                                        theta = sigma_, l = l)
    shrinked_K <- switch(
      inv_method,
      "chol" = chol2inv(chol(K + lambda_krls * diag(nrow(K)))),
      "ginv" = bayesianrvfl::my_ginv(K + lambda_krls * diag(nrow(K)))
    )
    Sigma <-
      sqrt(diag(K_star2 - crossprod(K_star, shrinked_K) %*% K_star))
    return (list(mean = preds,
                 sd = Sigma))
  } else {
    return(preds)
  }
}
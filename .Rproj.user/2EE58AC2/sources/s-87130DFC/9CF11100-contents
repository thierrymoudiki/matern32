/* utils */

// [[Rcpp::export]]
double sum_cpp(NumericVector x)
{
  unsigned long int n = x.size();
  double res = 0;
  for(int i = 0; i < n; i++) {
    res += x(i);
  }
  return(res);
}

// [[Rcpp::export]]
double l2_norm(NumericVector x)
{
  unsigned long int n = x.size();
  double res = 0;
  for(int i = 0; i < n; i++) {
    res += pow(x(i), 2);
  }
  return(sqrt(res));
}

// [[Rcpp::export]]
double weighted_l2_norm(NumericVector x, NumericVector theta)
{
  unsigned long int n = x.size();
  if (theta.size() != n) {
    ::Rf_error("you must have x.size() == theta.size()");
  }
  double res = 0;
  for(int i = 0; i < n; i++) {
    res += pow(x(i), 2)/pow(theta(i), 2);
  }
  return(sqrt(res));
}


/* Gaussian kernel */

// [[Rcpp::export]]
NumericMatrix gaussian_kxx_cpp(NumericMatrix x, double l, NumericVector theta)
{
  unsigned long int n = x.nrow();
  NumericMatrix res(n, n);

  for(int i = 0; i < n; i++) {
    for(int j = i; j < n; j++) {
      res(i , j) = exp(-0.5*pow(weighted_l2_norm(x(i, _) - x(j, _), theta), 2));
      res(j , i) = res(i , j);
    }
  }
  return(pow(l, 2)*res);
}

// [[Rcpp::export]]
NumericMatrix gaussian_kxstar_cpp(NumericMatrix newx, NumericMatrix x,
                                  double l, NumericVector theta)
{
  unsigned long int m = newx.nrow();
  unsigned long int n = x.nrow();
  NumericMatrix res(m, n);

  for(int i = 0; i < m; i++) {
    for(int j = 0; j < n; j++) {
      res(i , j) = exp(-0.5*pow(weighted_l2_norm(newx(i, _) - x(j, _), theta), 2));
    }
  }
  return(pow(l, 2)*res);
}

/* Matérn 3/2 kernel */

// [[Rcpp::export]]
NumericMatrix matern32_kxx_cpp(NumericMatrix x, double l, NumericVector theta)
{
  unsigned long int n = x.nrow();
  NumericMatrix res(n, n);
  double sqrt3 = sqrt(3);
  double temp = 0;

  for(int i = 0; i < n; i++) {
    for(int j = i; j < n; j++) {
      temp = sqrt3*sqrt(weighted_l2_norm(x(i, _) - x(j, _), theta));
      res(i , j) = (1 + temp)*exp(-temp);
      res(j , i) = res(i , j);
    }
  }
  return(pow(l, 2)*res);
}

// [[Rcpp::export]]
NumericMatrix matern32_kxstar_cpp(NumericMatrix newx, NumericMatrix x,
                                  double l, NumericVector theta)
{
  unsigned long int m = newx.nrow();
  unsigned long int n = x.nrow();
  NumericMatrix res(m, n);
  double temp = 0;
  double sqrt3 = sqrt(3);

  for(int i = 0; i < m; i++) {
    for(int j = 0; j < n; j++) {
      temp = sqrt3*sqrt(weighted_l2_norm(newx(i, _) - x(j, _), theta));
      res(i , j) = (1 + temp)*exp(-temp);
    }
  }

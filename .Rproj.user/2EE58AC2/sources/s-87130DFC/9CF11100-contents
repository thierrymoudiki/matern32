/* Matérn 5/2 kernel */

// [[Rcpp::export]]
NumericMatrix matern52_kxx_cpp(NumericMatrix x, double l, NumericVector theta)
{
  unsigned long int n = x.nrow();
  NumericMatrix res(n, n);
  NumericVector diff(n);
  double sqrt5 = sqrt(5);
  double temp = 0;

  for(int i = 0; i < n; i++) {
    for(int j = i; j < n; j++) {
      diff = x(i, _) - x(j, _);
      temp = sqrt5*weighted_l2_norm(diff, theta);
      res(i , j) = (1 + temp + pow(temp, 2)/3)*exp(-temp);
      res(j , i) = res(i , j);
    }
  }
  return(pow(l, 2)*res);
}

// [[Rcpp::export]]
NumericMatrix matern52_kxstar_cpp(NumericMatrix newx, NumericMatrix x,
                                  double l, NumericVector theta)
{
  unsigned long int m = newx.nrow();
  unsigned long int n = x.nrow();
  NumericMatrix res(m, n);
  NumericVector diff(n);
  double temp = 0;
  double sqrt5 = sqrt(5);

  for(int i = 0; i < m; i++) {
    for(int j = 0; j < n; j++) {
      diff = newx(i, _) - x(j, _);
      temp = sqrt5*weighted_l2_norm(diff, theta);
      res(i , j) = (1 + temp + pow(temp, 2)/3)*exp(-temp);
    }
  }
  return(pow(l, 2)*res);
}

